{
  "version": 2,
  "framework": "vite",
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/vite"
    },
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/client/dist/$1"
    }
  ],
  "env": {
    "VITE_API_URL": "/api"
  }
}